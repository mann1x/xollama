  <dict>
    <key>CFBundleDisplayName</key>
    <string>xOllama</string>
    <key>CFBundleExecutable</key>
    <string>xOllama</string>
    <key>CFBundleIconFile</key>
    <string>icon.icns</string>
    <key>CFBundleIdentifier</key>
    <string>com.mann1x.xollama</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>xOllama</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0.0.0</string>
    <key>DTCompiler</key>
    <string>com.apple.compilers.llvm.clang.1_0</string>
    <key>DTSDKBuild</key>
    <string>22E245</string>
    <key>DTSDKName</key>
    <string>macosx14.0</string>
    <key>DTXcode</key>
    <string>1431</string>
    <key>DTXcodeBuild</key>
    <string>14E300c</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLName</key>
        <string>xOllama URL</string>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>xollama</string>
          <!-- ollama:// as well, and deliberately. Sign-in opens
               https://ollama.com/connect?...&amp;launch=true and ollama.com
               picks the scheme it redirects to; declaring only xollama would
               leave that redirect with no handler on a Mac that has no stock
               Ollama.app, and break sign-in silently. Unlike the Windows
               registry key this claims nothing from anyone: LaunchServices
               arbitrates between claimants and the user can choose, and
               removing this bundle never removes another app's registration.
               The Windows side is narrower for exactly that reason; see
               OllamaSchemeUnclaimed in app/xollama.iss. -->
          <string>ollama</string>
        </array>
      </dict>
    </array>
  </dict>
</plist>
