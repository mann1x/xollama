# The xollama container image, assembled from a prebuilt payload.
#
# Built by .github/workflows/docker-release.yaml from the context that
# scripts/docker-assemble.sh stages: rootfs/bin/xollama and rootfs/lib/ollama,
# every native piece of which is a sha256-pinned artifact (plans/docker-image.md).
# Not buildable from the repository root on its own; the upstream Dockerfile,
# which compiles everything, stays upstream's.
#
# The runtime layer matches upstream's final stage, with one difference that
# matters: xollama binds XOLLAMA_HOST only (envconfig.DefaultPort, 22434) and
# never reads OLLAMA_HOST, so upstream's OLLAMA_HOST=0.0.0.0:11434 would leave
# the server on the container's loopback, unreachable from outside.
FROM ubuntu:24.04
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libvulkan1 libopenblas0 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY rootfs/bin/xollama /usr/bin/xollama
COPY rootfs/lib/ollama /usr/lib/ollama
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_VISIBLE_DEVICES=all
ENV XOLLAMA_HOST=0.0.0.0:22434
EXPOSE 22434
ENTRYPOINT ["/usr/bin/xollama"]
CMD ["serve"]
